{
  "name": "coe-quality-ia",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prestart": "node scripts/gerar-indice.mjs",
    "prebuild": "node scripts/gerar-indice.mjs && node scripts/verificar-tokens.mjs",
    "conteudo": "node scripts/gerar-indice.mjs",
    "tokens": "node scripts/verificar-tokens.mjs",
    "servir": "http-server dist/coe-quality-ia/browser -p 4300 --proxy http://localhost:4300?",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "test:coe": "jest --config coe-tests/jest.config.ts",
    "test:mutacao": "stryker run coe-tests/stryker.conf.json",
    "e2e:coe": "playwright test -c coe-tests/e2e/playwright.config.ts",
    "e2e:coe:demo": "COE_DEMO=1 playwright test -c coe-tests/e2e/playwright.config.ts",
    "lighthouse:coe": "lhci autorun --config=coe-tests/e2e/lighthouserc.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@azure/msal-angular": "^3.1.0",
    "@azure/msal-browser": "^3.30.0",
    "marked": "^14.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@testing-library/angular": "^17.3.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "http-server": "^14.1.1",
    "jasmine-core": "~5.2.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "^14.4.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.2",
    "yaml": "^2.9.1"
  }
}
